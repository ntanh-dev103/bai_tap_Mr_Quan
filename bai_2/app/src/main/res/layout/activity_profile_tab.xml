<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:background="#F7F8FC" android:padding="20dp">
    <ImageView android:layout_width="120dp" android:layout_height="120dp" android:src="@android:drawable/sym_def_app_icon" android:layout_gravity="center" android:contentDescription="Avatar" />
    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Nguyễn Văn A" android:textSize="24sp" android:textStyle="bold" android:textColor="#1A237E" android:layout_gravity="center" android:layout_marginTop="10dp" android:layout_marginBottom="18dp" />
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center" android:layout_marginBottom="16dp">
        <Button android:id="@+id/btnInfo" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Thông tin" />
        <Button android:id="@+id/btnHistory" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Lịch sử" android:layout_marginStart="6dp" android:layout_marginEnd="6dp" />
        <Button android:id="@+id/btnSetting" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Cài đặt" />
    </LinearLayout>
    <FrameLayout android:id="@+id/fragmentContainer" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:background="#FFFFFF" />
</LinearLayout>
